{
  "name": "@nefan/html",
  "version": "0.1.0",
  "description": "Never Ending Fantasy — 2D top-down HTML client",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "test": "node --import tsx --test test/*.test.ts",
    "precoverage": "mkdir -p coverage",
    "coverage": "node --enable-source-maps --import tsx --test --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info test/*.test.ts",
    "crap": "tsx ../nefan-core/scripts/crap-score.ts --cliente",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json",
    "format": "prettier --write src"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@types/three": "^0.170.0",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.4",
    "tsx": "^4.23.15",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.62.1",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "three": "^0.170.0"
  }
}
