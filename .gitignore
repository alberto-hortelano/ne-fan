# Python
.venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/

# AI models cache (large binary files)
*.ckpt
*.safetensors
*.bin
!ai_server/requirements.txt

# Generated outputs
test_outputs/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Local config
.mcp.json
.env
# .claude/: config local ignorada, salvo lo que es de EQUIPO (se versiona):
# los roles de agente, las skills, los hooks y los settings que los cablean.
# settings.local.json sigue fuera: ahí van las preferencias de cada uno.
.claude/*
!.claude/agents/
!.claude/skills/
!.claude/hooks/
!.claude/settings.json

# Obsolete / archived projects
NEFan/
archive/

# Archivo local de material generado que sale del REPO pero no de la MÁQUINA
# (imágenes de estilo, runs de labs, saves de sesiones). Espeja la ruta que
# cada cosa tenía en el juego: archivo/nefan-core/data/styles/anime/overworld/…
# Un `mv` de vuelta lo restaura. NADA generado se borra: se archiva.
/archivo/

# Generated asset caches
cache/
godot/cache/
nefan-html/public/sprites/

# Saved narrative sessions (Godot↔HTML shared)
saves/

# Mixamo/character assets (license prohibits redistribution)
/assets/characters/
# Enlace de compatibilidad para que el proyecto Godot siga resolviendo
# res://assets/characters/… mientras vive; muere con godot/.
godot/assets/characters
vendor/

# Session recordings
godot/recordings/

# QA: capturas de cada corrida (regenerables)
qa/capturas/

# Cobertura (regenerable con `npm run coverage`)
nefan-core/coverage/

# Mutation testing (regenerable con `npm run mutate`)
nefan-core/reports/
nefan-core/.stryker-tmp/

# Personal scratch space
todo.md
sandbox/
scene_gen_tests/

# Contenido generado por juego (snapshots de mundo, registros de estilo) —
# regenerable desde el título, no se versiona
nefan-core/data/games/*/world/

# Godot 4 editor
godot/.godot/
*.import
export_presets.cfg

# Node.js
node_modules/
narrative-mcp/dist/
nefan-core/dist/

# Contenido creado por el jugador (mundos y estilos subidos) — no se versiona
nefan-core/data/games/user_*/
nefan-core/data/styles/user_*/
.playwright-mcp/
nefan-core/data/styles/_staging/

# Equipo de agentes: el andamio del ciclo NO entra al repo (ver docs/agents/README.md).
# Solo perduran requisitos.md (qué se pidió) y qa.md (qué se verificó).
docs/agents/*/plan.md
docs/agents/*/implementacion.md
