{
  "name": "classify_scene",
  "description": "Classify every numbered segmented region of the scene image.",
  "input_schema": {
    "type": "object",
    "properties": {
      "segments": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "index": {
              "type": "integer",
              "minimum": 0,
              "description": "Índice de la región del overlay"
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "description": "Sustantivo corto en español"
            },
            "solid": {
              "type": "boolean",
              "description": "true si un personaje a pie NO puede atravesarlo"
            },
            "tall": {
              "type": "boolean",
              "description": "true si es más alto que un personaje (se dibuja por encima)"
            },
            "element_id": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "index",
            "label",
            "solid",
            "tall"
          ],
          "additionalProperties": false
        },
        "description": "Una entrada por CADA índice del overlay, exactamente una vez"
      }
    },
    "required": [
      "segments"
    ]
  }
}
