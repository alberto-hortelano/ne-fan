{
  "name": "react_to_player",
  "description": "Decide if the player's dialogue choice/free-text reshapes the open world. Return zero or more consequences.",
  "input_schema": {
    "type": "object",
    "properties": {
      "consequences": {
        "type": "array",
        "items": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "type": {
                  "const": "dialogue",
                  "type": "string"
                },
                "speaker": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Quién habla (nombre del NPC)"
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Lo que dice"
                },
                "choices": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "maxItems": 3,
                  "description": "Hasta 3 opciones de respuesta ofrecidas al jugador"
                }
              },
              "required": [
                "type",
                "speaker",
                "text"
              ]
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "const": "story_update",
                  "type": "string"
                },
                "delta": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Frase que se añade al hilo narrativo (story_so_far)"
                }
              },
              "required": [
                "type",
                "delta"
              ]
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "const": "spawn_entity",
                  "type": "string"
                },
                "entity_kind": {
                  "type": "string",
                  "enum": [
                    "npc",
                    "building",
                    "object"
                  ]
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Etiqueta: lo que el jugador lee al mirarla (el rótulo). Nombre propio si lo tiene"
                },
                "description": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Procedencia: el texto exacto (en español) del que se genera su arte — aspecto, no biografía; en un NPC, el prompt del skin. Sin ella se pinta con `name`"
                },
                "position_hint": {
                  "type": "string",
                  "description": "Pista de dónde aparece, p.ej. 'junto a la fuente'"
                },
                "role": {
                  "type": "string",
                  "enum": [
                    "peasant",
                    "guard",
                    "villager",
                    "merchant",
                    "hostile"
                  ],
                  "description": "NPCs: preset de conducta. Los cuatro ambientales (peasant/guard/villager/merchant) deambulan; `hostile` ATACA al jugador y el motor del juego deriva su vida, arma y agresividad — no las declaras tú. No es el oficio: un bandido o un lobo son `hostile` y su identidad va en `name`/`description`. Ausente ⇒ villager"
                },
                "style_ref": {
                  "type": "string",
                  "description": "NPCs: id de la referencia de personaje de world.style_refs.characters que mejor case con su aspecto (guía el skin IA). Ausente/desconocido cae al default por rol"
                },
                "character_type": {
                  "type": "string"
                }
              },
              "required": [
                "type",
                "entity_kind",
                "name"
              ]
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "const": "schedule_event",
                  "type": "string"
                },
                "description": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Qué ocurrirá y bajo qué condición. Persiste en tu agenda (context.scheduled_events) hasta que lo dispares y lo retires con la tool scheduled_event_resolve(id)"
                },
                "trigger": {
                  "type": "string",
                  "description": "Condición de disparo (texto libre)"
                }
              },
              "required": [
                "type",
                "description"
              ]
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "const": "plugin_event",
                  "type": "string"
                },
                "plugin_id": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Id del plugin declarativo destino"
                },
                "event_type": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Tipo de evento que consume el plugin"
                },
                "payload": {
                  "type": "object",
                  "additionalProperties": {},
                  "description": "Datos del evento (objeto)"
                }
              },
              "required": [
                "type",
                "plugin_id",
                "event_type"
              ]
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "const": "noop",
                  "type": "string"
                }
              },
              "required": [
                "type"
              ]
            }
          ]
        },
        "maxItems": 4,
        "description": "Lista de consecuencias (máx 4). [] si no hay reacción"
      }
    },
    "required": [
      "consequences"
    ]
  }
}
