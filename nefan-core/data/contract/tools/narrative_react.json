{
  "name": "react_to_player",
  "description": "Decide if the player's dialogue choice/free-text reshapes the open world. Return zero or more consequences.",
  "input_schema": {
    "type": "object",
    "properties": {
      "consequences": {
        "type": "array",
        "items": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "type": {
                  "const": "dialogue",
                  "type": "string"
                },
                "speaker": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Quién habla (nombre del NPC)"
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Lo que dice"
                },
                "choices": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "maxItems": 3
                }
              },
              "required": [
                "type",
                "speaker",
                "text"
              ]
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "const": "story_update",
                  "type": "string"
                },
                "delta": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Frase que se añade al hilo narrativo (story_so_far)"
                }
              },
              "required": [
                "type",
                "delta"
              ]
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "const": "spawn_entity",
                  "type": "string"
                },
                "entity_kind": {
                  "type": "string",
                  "enum": [
                    "npc",
                    "building",
                    "object"
                  ]
                },
                "description": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Descripción en español de la entidad a materializar"
                },
                "name": {
                  "type": "string"
                },
                "position_hint": {
                  "type": "string"
                },
                "role": {
                  "type": "string",
                  "enum": [
                    "peasant",
                    "guard",
                    "villager",
                    "merchant"
                  ]
                },
                "style_ref": {
                  "type": "string"
                },
                "texture_hash": {
                  "type": "string"
                },
                "model_hash": {
                  "type": "string"
                },
                "character_type": {
                  "type": "string"
                }
              },
              "required": [
                "type",
                "entity_kind",
                "description"
              ]
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "const": "schedule_event",
                  "type": "string"
                },
                "description": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Qué ocurrirá y bajo qué condición. Persiste en tu agenda (context.scheduled_events) hasta que lo dispares y lo retires con la tool scheduled_event_resolve(id)"
                },
                "trigger": {
                  "type": "string"
                }
              },
              "required": [
                "type",
                "description"
              ]
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "const": "plugin_event",
                  "type": "string"
                },
                "plugin_id": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Id del plugin declarativo destino"
                },
                "event_type": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Tipo de evento que consume el plugin"
                },
                "payload": {
                  "type": "object",
                  "additionalProperties": {}
                }
              },
              "required": [
                "type",
                "plugin_id",
                "event_type"
              ]
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "const": "noop",
                  "type": "string"
                }
              },
              "required": [
                "type"
              ]
            }
          ]
        },
        "maxItems": 4,
        "description": "Lista de consecuencias (máx 4). [] si no hay reacción"
      }
    },
    "required": [
      "consequences"
    ]
  }
}
