{
  "name": "orient_weapon",
  "description": "Return the grip point and orientation vectors for a 3D weapon mesh.",
  "input_schema": {
    "type": "object",
    "properties": {
      "grip_point_normalized": {
        "type": "array",
        "items": [
          {
            "type": "number"
          },
          {
            "type": "number"
          },
          {
            "type": "number"
          }
        ],
        "minItems": 3,
        "maxItems": 3,
        "description": "Punto de agarre en bbox normalizada [0..1]^3"
      },
      "blade_direction": {
        "type": "array",
        "items": [
          {
            "type": "number"
          },
          {
            "type": "number"
          },
          {
            "type": "number"
          }
        ],
        "minItems": 3,
        "maxItems": 3,
        "description": "Vector (será normalizado): del agarre hacia punta/filo/frente"
      },
      "up_direction": {
        "type": "array",
        "items": [
          {
            "type": "number"
          },
          {
            "type": "number"
          },
          {
            "type": "number"
          }
        ],
        "minItems": 3,
        "maxItems": 3,
        "description": "Vector (será normalizado): perpendicular a blade_direction, cara 'arriba'"
      },
      "weapon_type": {
        "type": "string",
        "enum": [
          "sword",
          "shield",
          "axe",
          "mace",
          "staff",
          "bow",
          "dagger",
          "spear",
          "generic"
        ]
      },
      "grip_length_normalized": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "confidence": {
        "type": "number",
        "minimum": 0,
        "maximum": 1,
        "description": "0.9+ si agarre y hoja son claros; <0.5 si la malla parece rota"
      },
      "notes": {
        "type": "string"
      }
    },
    "required": [
      "grip_point_normalized",
      "blade_direction",
      "up_direction",
      "weapon_type",
      "confidence"
    ]
  }
}
