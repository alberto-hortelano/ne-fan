{
  "name": "@nefan/core",
  "version": "0.1.0",
  "description": "Never Ending Fantasy — shared game logic (combat, AI, state)",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./contracts": {
      "types": "./dist/src/contracts/index.d.ts",
      "default": "./dist/src/contracts/index.js"
    },
    "./contracts/*": {
      "types": "./dist/src/contracts/*.d.ts",
      "default": "./dist/src/contracts/*.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "node --import tsx --test test/*.test.ts",
    "test:mutate": "node --import tsx --test test/scene-normalize.test.ts test/plugins-dsl.test.ts test/tile-greybox.test.ts test/stage-greybox.test.ts test/blueprint-collision.test.ts test/combat-resolver.test.ts",
    "lint": "eslint src bridge services test scripts",
    "format": "prettier --write src bridge services test scripts",
    "dev": "tsx bridge/ws-server.ts",
    "dump-config": "tsx scripts/dump-config.ts",
    "dump-scene": "tsx scripts/dump-scene.ts",
    "gen:contract": "tsx scripts/gen-contract.ts",
    "prebuild": "tsx scripts/dump-config.ts",
    "predev": "tsx scripts/dump-config.ts",
    "pretest": "tsx scripts/dump-config.ts",
    "precoverage": "mkdir -p coverage",
    "coverage": "node --enable-source-maps --import tsx --test --experimental-test-coverage --test-reporter=lcov --test-reporter-destination=coverage/lcov.info test/*.test.ts",
    "crap": "tsx scripts/crap-score.ts",
    "mutate": "stryker run",
    "verify": "npm run build && npm run lint && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "^10.0.0",
    "@types/node": "^24.13.3",
    "@types/ws": "^8.18.1",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.4",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.62.1"
  },
  "dependencies": {
    "undici": "^8.7.0",
    "ws": "^8.20.0",
    "zod": "^3.25.76"
  }
}
