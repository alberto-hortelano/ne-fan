{
  "name": "@nefan/core",
  "version": "0.1.0",
  "description": "Never Ending Fantasy — shared game logic (combat, AI, state)",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./contracts": {
      "types": "./dist/src/contracts/index.d.ts",
      "default": "./dist/src/contracts/index.js"
    },
    "./contracts/*": {
      "types": "./dist/src/contracts/*.d.ts",
      "default": "./dist/src/contracts/*.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "typecheck:labs": "tsc --noEmit -p tsconfig.labs.json",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json",
    "test": "node --import tsx --test --test-concurrency=${NEFAN_TEST_CONCURRENCY:-4} test/*.test.ts",
    "lint": "eslint src bridge services test scripts",
    "format": "prettier --write src bridge services test scripts",
    "dev": "tsx bridge/ws-server.ts",
    "dump-config": "tsx scripts/dump-config.ts",
    "dump-physics": "tsx scripts/dump-physics.ts",
    "gen:contract": "tsx scripts/gen-contract.ts",
    "prebuild": "tsx scripts/dump-config.ts",
    "predev": "tsx scripts/dump-config.ts",
    "pretest": "tsx scripts/dump-config.ts",
    "precoverage": "tsx scripts/dump-config.ts && mkdir -p coverage",
    "coverage": "node --enable-source-maps --import tsx --test --test-concurrency=${NEFAN_TEST_CONCURRENCY:-4} --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info test/*.test.ts",
    "crap": "tsx scripts/crap-score.ts",
    "deuda": "tsx scripts/deuda.ts",
    "mutate": "tsx scripts/mutate.ts",
    "mutacion": "tsx scripts/mutacion.ts",
    "afectado": "tsx scripts/afectado.ts",
    "verify": "npm run build && npm run typecheck:scripts && npm run typecheck:labs && npm run typecheck:tests && npm run lint && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "^10.0.0",
    "@types/node": "^24.13.3",
    "@types/ws": "^8.18.1",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.4",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.62.1"
  },
  "dependencies": {
    "undici": "^8.7.0",
    "ws": "^8.20.0",
    "zod": "^3.25.76"
  }
}
